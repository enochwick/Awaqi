# -----------------------------------------------------------------------------
# This repo IS the theme — its files live at the root so that git-based
# installers (Deployer for Git, WP Pusher, cPanel) can treat the repository as
# a WordPress theme directly.
#
# Note: do NOT add rules like /assets/ or /index.php here. Those are the
# theme's own files now, and ignoring them silently ships a broken theme.
# -----------------------------------------------------------------------------

# Raw 3D source — NEVER commit these.
# The interior OBJ alone is 1.2 GB. GitHub rejects any file over 100 MB, and
# even under LFS a file that size makes the repo unusable. Keep raw sources in
# cloud storage; commit only the optimized GLB in assets/models/.
/raw-3d/
*.obj
*.mtl
*.c4d
*.fbx
*.blend
*.blend1
*.max
*.rar
*.zip

# Deployer
/vendor/
/.dep/
deploy.local.php

# Node (only if a build step is added later)
/node_modules/
npm-debug.log*

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
