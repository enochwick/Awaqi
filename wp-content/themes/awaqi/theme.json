{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1100px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "palette": [
        { "slug": "background", "color": "#05060a", "name": "Background" },
        { "slug": "surface",    "color": "#0b0d14", "name": "Surface" },
        { "slug": "ink",        "color": "#f4f5f7", "name": "Ink" },
        { "slug": "muted",      "color": "#9ea1ad", "name": "Muted" },
        { "slug": "accent",     "color": "#7c5cff", "name": "Accent" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontSizes": [
        { "slug": "small",  "size": "14px", "name": "Small" },
        { "slug": "medium", "size": "16px", "name": "Medium" },
        { "slug": "large",  "size": "24px", "name": "Large" },
        { "slug": "huge",   "size": "clamp(34px, 7vw, 68px)", "name": "Huge" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--ink)"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      }
    }
  }
}
